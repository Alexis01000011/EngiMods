#!/bin/sh
# Antes de cada commit. Se activa una vez por copia del repo:
#   git config core.hooksPath .githooks
set -eu

fail() {
  printf 'pre-commit: %s\n' "$1" >&2
  exit 1
}

if [ "$(git symbolic-ref --short -q HEAD || true)" = "main" ]; then
  fail "no hagas commits en main. Crea una rama: git switch -c em-0XX-descripcion"
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)

blocked=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env$|(^|/)db\.sqlite3$|^media/' || true)
if [ -n "$blocked" ]; then
  fail "estos archivos no se suben al repo (AGENTS.md, sección 8): $blocked"
fi

if git diff --cached -U0 --diff-filter=ACMR | grep '^+' |
  grep -qE '(sk|rk|pk)_(test|live)_[0-9A-Za-z]{8,}|whsec_[0-9A-Za-z]{8,}'; then
  fail "lo que vas a subir tiene algo que parece una llave de Stripe. Quítala y léela de .env."
fi

if printf '%s\n' "$staged" | grep -qE '\.py$'; then
  if command -v uv >/dev/null 2>&1; then
    uv run ruff check . || fail "ruff encontró problemas. Prueba: uv run ruff check . --fix"
    uv run ruff format --check . || fail "falta formato. Corre: uv run ruff format ."
  else
    echo "pre-commit: uv no está instalado; me salto ruff (la CI lo revisará)." >&2
  fi
fi
