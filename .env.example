# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repo.
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# DATABASE_URL=postgres://usuario:clave@localhost:5432/engimods

# Staging y producción (EM-005, docs/despliegue.md). En desarrollo se dejan sin definir.
# HTTPS_ONLY=True redirige a HTTPS, marca las cookies como seguras y activa HSTS. Solo detrás
# de un proxy que termine TLS y ponga X-Forwarded-Proto. Por defecto: False.
# HTTPS_ONLY=False
# Duración de HSTS en segundos cuando HTTPS_ONLY=True. Por defecto: 3600.
# SECURE_HSTS_SECONDS=3600

# Servicios Git aceptados para el enlace del repositorio de una entrega (EM-070), separados
# por comas. Por defecto: github.com,gitlab.com,bitbucket.org,codeberg.org
# GIT_REPOSITORY_HOSTS=github.com,gitlab.com,bitbucket.org,codeberg.org

# Plazo de revisión de una entrega, en horas (EM-071). Por defecto: 24.
# REVIEW_DEADLINE_HOURS=24

# Stripe en modo prueba (EM-009). Instrucciones en docs/stripe.md.
# Usa solo llaves de prueba (empiezan con sk_test_ y pk_test_). Sin ellas el sitio arranca,
# pero el pago no funciona.
# Clave secreta y clave publicable: Dashboard de Stripe, Desarrolladores, Claves de API.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# Secreto del webhook: en local, el que imprime `stripe listen`; en staging, el del endpoint.
# STRIPE_WEBHOOK_SECRET=
