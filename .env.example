# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repo.
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# DATABASE_URL=postgres://usuario:clave@localhost:5432/engimods

# Stripe en modo prueba (EM-009). Instrucciones en docs/stripe.md.
# Usa solo llaves de prueba (empiezan con sk_test_ y pk_test_). Sin ellas el sitio arranca,
# pero el pago no funciona.
# Clave secreta y clave publicable: Dashboard de Stripe, Desarrolladores, Claves de API.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# Secreto del webhook: en local, el que imprime `stripe listen`; en staging, el del endpoint.
# STRIPE_WEBHOOK_SECRET=
